# Server configuration
PORT=5000

# Database configuration
MONGODB_URI=mongodb://localhost:27017/photo-studio

# CORS configuration (Frontend URL)
CLIENT_URL=http://localhost:3000

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
ADMIN_EMAIL=admin@example.com

# WhatsApp Integration Configuration
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_chosen_webhook_verify_token_here
WHATSAPP_API_VERSION=v20.0

# n8n Integration Configuration
N8N_LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Zoho CRM Direct Integration Configuration
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here
ZOHO_REDIRECT_URI=http://localhost:5000/api/zoho/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com/crm/v2
# Payment Webhook Configuration
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here
